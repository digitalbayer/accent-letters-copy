{
  "name": "accent-letters-copy-extension",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy respecting, offline browser extension for copying accented A to Z Latin letters.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-data.mjs",
    "generate:check": "node scripts/generate-data.mjs --check",
    "unicode:subset": "node scripts/extract-unicode-subset.mjs",
    "icons": "node scripts/create-icons.mjs",
    "build": "npm run generate:check && npm run icons && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "lint:firefox": "web-ext lint --source-dir build/firefox --warnings-as-errors",
    "validate:packages": "node scripts/validate-packages.mjs",
    "assets": "node scripts/create-store-assets.mjs",
    "validate": "npm run generate:check && npm test && npm run build && npm run lint:firefox && npm run validate:packages && npm run test:browser && npm run assets"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "axe-core": "4.13.0",
    "sharp": "0.35.4",
    "web-ext": "10.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "license": "MIT"
}
